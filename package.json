{
  "name": "minfo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser-first music metadata workspace.",
  "scripts": {
    "dev": "vite",
    "predev": "run-s sync-runtime verify:runtime",
    "build": "run-s sync-runtime verify:runtime typecheck lint test:run build:app verify:dist-runtime",
    "build:app": "vite build",
    "preview": "vite preview",
    "sync-runtime": "node scripts/sync-media-runtime.mjs",
    "verify:runtime": "node scripts/verify-media-runtime.mjs public/media-runtime",
    "verify:dist-runtime": "node scripts/verify-media-runtime.mjs dist/media-runtime",
    "verify:dependencies": "pnpm audit signatures && pnpm audit --audit-level=low",
    "ci": "run-s verify:dependencies format:check build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@tabler/icons-vue": "3.51.0",
    "music-metadata": "12.3.5",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "npm-run-all2": "9.0.4",
    "prettier": "3.9.10",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
